{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:dev",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-c", "npm run build:dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "build (production)",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-c", "npm run build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-c", "npm run watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "type-check",
      "type": "shell",
      "command": "wsl",
      "args": ["-e", "bash", "-c", "npx tsc -p tsconfig.json --noEmit"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}
