{
  "Lab Metadata Block": {
    "prefix": "lab-meta",
    "body": [
      "LAB_NAME=\"${1:My Lab}\"",
      "LAB_DESCRIPTION=\"${2:Description}\"",
      "LAB_VERSION=${3:1.0}",
      "LAB_AUTHOR=\"${4:Author}\"",
      "LAB_EMAIL=\"${5:email@example.com}\"",
      "LAB_WEB=\"${6:https://example.com}\"",
      "",
      "$0"
    ],
    "description": "Insert Kathara lab metadata block"
  },
  "Device Interface": {
    "prefix": "dev-iface",
    "body": [
      "${1:device}[${2:0}]=\"${3:collision_domain}\""
    ],
    "description": "Assign a network interface to a device"
  },
  "Device Image": {
    "prefix": "dev-image",
    "body": [
      "${1:device}[image]=\"${2:kathara/base}\""
    ],
    "description": "Set the Docker image for a device"
  },
  "Device Memory": {
    "prefix": "dev-mem",
    "body": [
      "${1:device}[mem]=\"${2:128m}\""
    ],
    "description": "Set the memory limit for a device (e.g. 64m, 256m, 1g)"
  },
  "Device Port Forward": {
    "prefix": "dev-port",
    "body": [
      "${1:device}[port]=\"${2:3000}:${3:22}/${4|tcp,udp,sctp|}\""
    ],
    "description": "Forward a port from host to device"
  },
  "Device Bridged": {
    "prefix": "dev-bridged",
    "body": [
      "${1:device}[bridged]=\"true\""
    ],
    "description": "NAT-connect the device to the host network"
  },
  "Device IPv6": {
    "prefix": "dev-ipv6",
    "body": [
      "${1:device}[ipv6]=\"true\""
    ],
    "description": "Enable IPv6 for the device"
  },
  "Device Exec": {
    "prefix": "dev-exec",
    "body": [
      "${1:device}[exec]=\"${2:command}\""
    ],
    "description": "Run a shell command inside the device at startup"
  },
  "Device Sysctl": {
    "prefix": "dev-sysctl",
    "body": [
      "${1:device}[sysctl]=\"net.${2:ipv4.ip_forward=1}\""
    ],
    "description": "Set a sysctl value (only net.* namespace allowed)"
  },
  "Device Shell": {
    "prefix": "dev-shell",
    "body": [
      "${1:device}[shell]=\"${2:/bin/bash}\""
    ],
    "description": "Set the shell for the device"
  },
  "Device Volume": {
    "prefix": "dev-volume",
    "body": [
      "${1:device}[volume]=\"${2:/host/path}|${3:/guest/path}|${4|ro,rw,rx|}\""
    ],
    "description": "Mount a host volume inside the device"
  },
  "Device Ulimit": {
    "prefix": "dev-ulimit",
    "body": [
      "${1:device}[ulimit]=\"${2:nofile=1024:2048}\""
    ],
    "description": "Set a ulimit for the device"
  },
  "Router Boilerplate": {
    "prefix": "router",
    "body": [
      "${1:r1}[0]=\"${2:A}\"",
      "${1:r1}[1]=\"${3:B}\"",
      "${1:r1}[image]=\"kathara/frr\"",
      "${1:r1}[sysctl]=\"net.ipv4.ip_forward=1\"",
      "$0"
    ],
    "description": "Boilerplate for a Kathara router device"
  },
  "PC Boilerplate": {
    "prefix": "pc",
    "body": [
      "${1:pc1}[0]=\"${2:A}\"",
      "$0"
    ],
    "description": "Boilerplate for a Kathara PC device"
  }
}
