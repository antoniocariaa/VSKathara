{
  "name": "vskathara",
  "displayName": "VSKathará",
  "description": "Kathará network lab tooling: syntax highlighting, autocompletion, linting, commands, and topology view.",
  "version": "0.1.0",
  "icon": "logo.png",
  "publisher": "antoniocariaa",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Education",
    "Other"
  ],
  "keywords": [
    "kathara",
    "netkit",
    "network",
    "lab",
    "emulation",
    "cisco",
    "packet",
    "graph",
    "topology",
    "visualization",
    "syntax",
    "highlighting",
    "autocompletion"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KatharaFramework/VSKathara"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:shellscript",
    "workspaceContains:**/lab.conf"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lab-conf",
        "aliases": [
          "Kathara Lab Config",
          "lab.conf"
        ],
        "filenames": [
          "lab.conf"
        ],
        "configuration": "./language-configuration/lab-conf-language-configuration.json"
      },
      {
        "id": "lab-dep",
        "aliases": [
          "Kathara Lab Dependencies",
          "lab.dep"
        ],
        "filenames": [
          "lab.dep"
        ],
        "configuration": "./language-configuration/lab-dep-language-configuration.json"
      },
      {
        "id": "lab-ext",
        "aliases": [
          "Kathara External Networks",
          "lab.ext"
        ],
        "filenames": [
          "lab.ext"
        ],
        "configuration": "./language-configuration/lab-ext-language-configuration.json"
      },
      {
        "id": "shellscript",
        "extensions": [
          ".startup"
        ]
      }
    ],
    "grammars": [
      {
        "language": "lab-conf",
        "scopeName": "source.lab-conf",
        "path": "./syntaxes/lab-conf.tmLanguage.json"
      },
      {
        "language": "lab-dep",
        "scopeName": "source.lab-dep",
        "path": "./syntaxes/lab-dep.tmLanguage.json"
      },
      {
        "language": "lab-ext",
        "scopeName": "source.lab-ext",
        "path": "./syntaxes/lab-ext.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lab-conf",
        "path": "./snippets/lab-conf.snippets.json"
      }
    ],
    "commands": [
      {
        "command": "kathara.lstart",
        "title": "Start Lab",
        "category": "Kathara"
      },
      {
        "command": "kathara.lclean",
        "title": "Stop Lab",
        "category": "Kathara"
      },
      {
        "command": "kathara.lrestart",
        "title": "Restart Lab",
        "category": "Kathara"
      },
      {
        "command": "kathara.linfo",
        "title": "Lab Info",
        "category": "Kathara"
      },
      {
        "command": "kathara.connect",
        "title": "Connect to Device",
        "category": "Kathara"
      },
      {
        "command": "kathara.vstart",
        "title": "Start Device",
        "category": "Kathara"
      },
      {
        "command": "kathara.showTopology",
        "title": "Show Topology",
        "category": "Kathara",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceFilename == 'lab.conf'",
          "command": "kathara.showTopology",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceFilename == 'lab.conf'",
          "command": "kathara.lstart",
          "group": "kathara@1"
        },
        {
          "when": "resourceFilename == 'lab.conf'",
          "command": "kathara.lclean",
          "group": "kathara@2"
        },
        {
          "when": "resourceFilename == 'lab.conf'",
          "command": "kathara.showTopology",
          "group": "kathara@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kathara.lstart"
        },
        {
          "command": "kathara.lclean"
        },
        {
          "command": "kathara.lrestart"
        },
        {
          "command": "kathara.linfo"
        },
        {
          "command": "kathara.connect"
        },
        {
          "command": "kathara.vstart"
        },
        {
          "command": "kathara.showTopology"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "doctor": "node ./scripts/doctor.js",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "build:dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "pretest": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --ui tdd out/test/unit/**/*.test.js",
    "test:integration": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "mocha": "^11.3.0",
    "typescript": "^5.8.0"
  }
}
